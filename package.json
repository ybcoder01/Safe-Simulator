{
  "name": "safe-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "security:node": "node scripts/check-node-security.mjs",
    "prebuild": "node scripts/check-node-security.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "test:preview:smoke": "node scripts/preview-smoke.mjs"
  },
  "dependencies": {
    "@privy-io/node": "^0.36.0",
    "@privy-io/react-auth": "^3.51.0",
    "@safe-global/api-kit": "5.0.2",
    "@upstash/qstash": "2.11.3",
    "@upstash/redis": "1.38.3",
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "eslint-config-next": "16.4.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
