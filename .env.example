# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_DEV=false
APP_BASE_URL=http://localhost:3000
# Vercel system variable required only for protected Preview QStash callbacks.
VERCEL_AUTOMATION_BYPASS_SECRET=
CRON_SECRET=
SAFE_API_KEY=
# Optional server-only key for higher XDCScan source lookup limits.
XDCSCAN_API_KEY=
SAFE_TX_SERVICE_URL_1=
SAFE_TX_SERVICE_URL_50=
# Comma-separated URLs enable ranked fallback transports.
RPC_URL_1=
RPC_URL_50=
# Optional server-only debug RPC URLs. Unsupported methods degrade to receipt evidence.
TRACE_RPC_URL_1=
TRACE_RPC_URL_50=
TENDERLY_ACCESS_TOKEN=
SENTRY_DSN=
